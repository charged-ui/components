{
	"name": "@charged-ui/components",
	"version": "1.0.3-alpha.29",
	"description": "Universal web components built with Lit.",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "react-router build",
		"build:lib": "npm run build:types && vite build --config vite.config.lib.ts",
		"build:types": "tsc --project tsconfig.lib.json",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"@lit/react": "^1.0.8",
		"@react-router/node": "^7.12.0",
		"@react-router/serve": "^7.12.0",
		"clsx": "^2.1.1",
		"isbot": "^5.1.32",
		"lit": "^3.3.2",
		"motion": "^12.25.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-router": "^7.12.0"
	},
	"devDependencies": {
		"@react-router/dev": "^7.12.0",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"shiki": "^3.21.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-tsconfig-paths": "^6.0.4"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./alert": {
			"types": "./dist/alert.d.ts",
			"import": "./dist/alert.js"
		},
		"./package.json": "./package.json"
	}
}
