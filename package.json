    "./details": "./primitives/details/index.ts",
    "./details/details.mdx": "./primitives/details/details.mdx",
    "./dialog": "./primitives/dialog/index.ts",
    "./dialog/dialog.mdx": "./primitives/dialog/dialog.mdx",
    "./dots": "./backgrounds/dots/index.ts",
    "./dots/dots.mdx": "./backgrounds/dots/dots.mdx",
